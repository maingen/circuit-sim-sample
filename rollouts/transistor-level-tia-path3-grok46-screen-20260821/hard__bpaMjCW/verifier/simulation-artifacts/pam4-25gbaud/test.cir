R_TB_BUF_LOAD outp outn 100
* IHP SG13G2 25-Gbaud differential optical-receiver front end
*
* Public nodes: vcc mc mgc oa inp inn finalp finaln gc agc
*               bufinp bufinn outp outn pkdinp pkdinn detp detn
*
* =====================================================================
* Replica: Vin = I*Re = 0.7594 V
* =====================================================================
Xqrep vb vb erep 0 npn13G2 Nx=4
Rerep erep 0 366.5
Rqrep vcc vb 820
Cvb vb 0 50p
Cerep erep 0 10p

Xqcrep vcref vb erepc 0 npn13G2 Nx=4
Rerepc erepc 0 366.5
Rcrep vcc vcref 620
Cvcref vcref 0 5p

* =====================================================================
* TIA P + DOC
* =====================================================================
Xqcbp ctp vb inp 0 npn13G2 Nx=4
Rinp inp 0 366.5
Ltp vcc nltp 0.70n
Rctp nltp ctp 530

Rlpfp ctp ctpfp 2Meg
Clpfp ctpfp 0 8p
Riso_p ctpfp docbp 12k
Ciso_p docbp 0 1p
Xqdpr dcop vcref edp 0 npn13G2 Nx=1
Xqdps dummyp docbp edp 0 npn13G2 Nx=1
Redp edp 0 8000
Rldcp vcc dcop 30k
Rldsp vcc dummyp 30k
Cdcop dcop 0 1p
Cdummp dummyp 0 1p
Xqefdp vcc dummyp gdocp 0 npn13G2 Nx=1
Rgdocp gdocp 0 80k
Cgdocp gdocp 0 5p
Xmdoc_p inp gdocp 0 0 sg13_hv_nmos w=8u l=0.45u ng=1 m=8

* =====================================================================
* TIA N + DOC
* =====================================================================
Xqcbn ctn vb inn 0 npn13G2 Nx=4
Rinn inn 0 366.5
Ltn vcc nltn 0.70n
Rctn nltn ctn 530

Rlpfn ctn ctpfn 2Meg
Clpfn ctpfn 0 8p
Riso_n ctpfn docbn 12k
Ciso_n docbn 0 1p
Xqdnr dcon vcref edn 0 npn13G2 Nx=1
Xqdns dummyn docbn edn 0 npn13G2 Nx=1
Redn edn 0 8000
Rldcn vcc dcon 30k
Rldsn vcc dummyn 30k
Cdcon dcon 0 1p
Cdumnn dummyn 0 1p
Xqefdn vcc dummyn gdocn 0 npn13G2 Nx=1
Rgdocn gdocn 0 80k
Cgdocn gdocn 0 5p
Xmdoc_n inn gdocn 0 0 sg13_hv_nmos w=8u l=0.45u ng=1 m=8

Xqeftp vcc ctp ntp 0 npn13G2 Nx=2
Xqeftn vcc ctn ntn 0 npn13G2 Nx=2
Retp ntp 0 600
Retn ntn 0 600

* =====================================================================
* RF VGA 1
* =====================================================================
C1p ntp g1p 20n
C1n ntn g1n 20n
Rb1pt vcc g1p 16000
Rb1pb g1p 0 9000
Rb1nt vcc g1n 16000
Rb1nb g1n 0 9000

