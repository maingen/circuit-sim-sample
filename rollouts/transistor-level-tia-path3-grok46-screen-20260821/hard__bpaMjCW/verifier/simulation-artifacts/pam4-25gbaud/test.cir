Re1n e1n t1 28
Xmg1 e1p gc e1n 0 sg13_hv_nmos w=10u l=0.45u ng=1 m=20
Xmg1p e1p gc t1 0 sg13_hv_nmos w=10u l=0.45u ng=1 m=12
Xmg1n e1n gc t1 0 sg13_hv_nmos w=10u l=0.45u ng=1 m=12
