            ],
            "nodes": [
              "detp",
              "detn",
              "oa",
              "ag_ref",
              "agc",
              "agt",
              "ncp"
            ],
            "public_requirement": "A transistor-level AGC amplifier and manual or automatic gain selector must produce agc and select mgc or agc onto gc according to mc.",
            "electrical_reason": "The active AGC pair senses oa and ag_ref, with outputs ncp and agc; neither detp nor detn has any electrical connection to this amplifier or to an AGC error-summing network. Thus this stage cannot amplify detector error or close an amplitude-control loop. The transmission-gate selector is connected, but its automatic input is not a detector-derived AGC signal."
          }
        ]
      },
