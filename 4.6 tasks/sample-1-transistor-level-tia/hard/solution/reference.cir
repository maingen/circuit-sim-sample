XM_XMODE_PMGC gc mc mgc vcc sg13_hv_pmos w=80u l=0.45u ng=40 m=1 rfmode=1
XM_XMODE_NAGC gc mc agc 0 sg13_hv_nmos w=40u l=0.45u ng=20 m=1 rfmode=1
XM_XMODE_PAGC gc XMODE__mcb agc vcc sg13_hv_pmos w=80u l=0.45u ng=40 m=1 rfmode=1
R_XMODE_LOAD gc 0 1Meg
C_XMODE_LOAD gc 0 10f
